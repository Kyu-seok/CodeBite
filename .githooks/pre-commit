#!/usr/bin/env bash
# Runs the CI checks that cover what this commit touches, so a broken module,
# lint error or script is caught before it reaches a PR.
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency: git commit --no-verify
set -euo pipefail

# master only moves through merged PRs. A commit here usually means the checkout was switched
# under you (another session sharing this directory); branch first, or use a git worktree.
if [ "$(git branch --show-current)" = master ]; then
  echo "pre-commit: refusing to commit on master; switch to a branch first" >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
touches() { grep -qE "$1" <<<"$staged"; }

# git runs hooks with GIT_INDEX_FILE, GIT_DIR and friends pointing at this repository. JGit reads
# them too, so the Import tests' scratch repositories would act on this repository's index and fail.
while IFS= read -r var; do unset "$var"; done < <(compgen -e | grep '^GIT_')

if touches '^(common|backend|worker)/|^(build|settings)\.gradle'; then
  modules=()
  touches '^common/|^(build|settings)\.gradle' && modules+=(:common:test :backend:test :worker:test)
  touches '^backend/' && modules+=(:backend:test)
  touches '^worker/' && modules+=(:worker:test)
  echo "pre-commit: ./gradlew ${modules[*]}"
  ./gradlew -q "${modules[@]}"
fi

if touches '^frontend/'; then
  echo "pre-commit: frontend lint"
  (cd frontend && npm run -s lint -- --max-warnings 0)
  echo "pre-commit: frontend tests"
  (cd frontend && npm test -s)
fi

if touches '^scripts/.*\.sh$|^\.shellcheckrc$'; then
  if command -v shellcheck >/dev/null 2>&1; then
    echo "pre-commit: shellcheck"
    shellcheck -S warning scripts/*.sh
  else
    echo "pre-commit: shellcheck not installed, skipping (CI still runs it)"
  fi
  scripts/dev-env.test.sh
fi
