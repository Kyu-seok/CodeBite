#!/usr/bin/env bash
# Runs the CI checks that cover what this commit touches, so a broken module,
# lint error or script is caught before it reaches a PR.
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency: git commit --no-verify (which skips commit-msg too).
# A parallel implementer whose merge gate runs the tests skips only them: CODEBITE_SKIP_TESTS=1 git commit
# keeps every other check here and the commit-msg subject limit.
set -euo pipefail

# master only moves through merged PRs. A commit here usually means the checkout was switched
# under you (another session sharing this directory); branch first, or use a git worktree.
if [ "$(git branch --show-current)" = master ]; then
  echo "pre-commit: refusing to commit on master; switch to a branch first" >&2
  exit 1
fi

# The paths the checks below are chosen by: the staged ones, or CODEBITE_HOOK_PATHS (one per line)
# when a caller runs this file over paths of its own, as scripts/merge-ticket.sh --refresh does.
staged=${CODEBITE_HOOK_PATHS-$(git diff --cached --name-only --diff-filter=ACMR)}
touches() { grep -qE "$1" <<<"$staged"; }

# git runs hooks with GIT_INDEX_FILE, GIT_DIR and friends pointing at this repository. JGit reads
# them too, so the Import tests' scratch repositories would act on this repository's index and fail.
while IFS= read -r var; do unset "$var"; done < <(compgen -e | grep '^GIT_')

# Every commit: a document or comment pointing at a path or glossary term that isn't there.
echo "pre-commit: doc references"
python3 -I scripts/check-doc-references.py

# Every commit: a file of the walkthrough kit's copy edited here instead of in the kit (docs/adr/0012).
echo "pre-commit: walkthrough kit copy"
python3 -I scripts/copy-walkthrough-kit.py --check

# A module's sources and build file, not its Dockerfile, which no Gradle test reads.
if [ "${CODEBITE_SKIP_TESTS:-}" = 1 ]; then
  echo "pre-commit: CODEBITE_SKIP_TESTS=1, skipping the Gradle tests (the merge gate runs them)"
elif touches '^(common|backend|worker)/(src/|build\.gradle)|^(build|settings)\.gradle'; then
  modules=()
  touches '^common/(src/|build\.gradle)|^(build|settings)\.gradle' && modules+=(:common:test :backend:test :worker:test)
  touches '^backend/(src/|build\.gradle)' && modules+=(:backend:test)
  touches '^worker/(src/|build\.gradle)' && modules+=(:worker:test)
  echo "pre-commit: scripts/gradle-test.sh ${modules[*]}"
  scripts/gradle-test.sh -q "${modules[@]}"
fi

if touches '^frontend/'; then
  echo "pre-commit: frontend lint"
  (cd frontend && npm run -s lint -- --max-warnings 0)
  echo "pre-commit: frontend tests"
  (cd frontend && npm test -s)
fi

# frontend/publish.sh is the deploy's own script (docs/adr/0014), tested by scripts/frontend-publish.test.sh.
if touches '^scripts/|^frontend/publish\.sh$|^\.shellcheckrc$'; then
  if command -v shellcheck >/dev/null 2>&1; then
    echo "pre-commit: shellcheck"
    shellcheck -S warning scripts/*.sh frontend/publish.sh
  else
    echo "pre-commit: shellcheck not installed, skipping (CI still runs it)"
  fi
  # A helper copied from one Walkthrough tracer into another instead of moved into codebite.py.
  echo "pre-commit: tracer helpers"
  python3 -I scripts/check-tracer-helpers.py
  echo "pre-commit: script tests"
  scripts/run-script-tests.sh
fi
