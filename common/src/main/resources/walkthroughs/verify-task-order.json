{
 "format": "walkthrough/1",
 "title": {
  "en": "Verify Task Order",
  "ko": "작업 순서 검증"
 },
 "approach": {
  "en": "Count what each task waits for; a task waiting for nothing is ready, and finishing it lowers the count of every task that needs it. Every task gets finished exactly when no cycle holds some of them waiting.",
  "ko": "작업마다 기다리는 선행 작업 수를 셉니다. 기다리는 것이 없는 작업은 준비된 것이고, 그 작업을 끝내면 그것이 필요한 작업들의 수가 줄어듭니다. 순환이 없을 때만 모든 작업이 끝납니다."
 },
 "views": [
  {
   "id": "tasks",
   "type": "graph",
   "directed": true,
   "title": {
    "en": "tasks (arrow: needs; under: waiting for)",
    "ko": "작업 (화살표: 필요함, 아래: 기다리는 수)"
   }
  },
  {
   "id": "ready",
   "type": "queue",
   "title": {
    "en": "ready",
    "ko": "ready (준비된 작업)"
   },
   "empty": {
    "en": "empty",
    "ko": "비어 있음"
   }
  },
  {
   "id": "done",
   "type": "output",
   "title": {
    "en": "finished, in order",
    "ko": "끝낸 작업 (순서대로)"
   },
   "empty": {
    "en": "none yet",
    "ko": "아직 없음"
   }
  }
 ],
