{
 "format": "walkthrough/1",
 "title": {
  "en": "Clone the Quest Log",
  "ko": "퀘스트 로그 복제"
 },
 "approach": {
  "en": "A copy's related can reach a node that has no copy yet, so make every copy first, keeping a map from each original to its copy; then each copy's next and related are the copies of the nodes the original's reach.",
  "ko": "사본의 related는 아직 사본이 없는 노드를 가리킬 수 있으므로, 먼저 모든 노드의 사본을 만들어 원본마다 사본을 맵에 적어 둡니다. 그다음 사본의 next와 related를 원본의 next와 related가 가리키는 노드의 사본으로 정합니다."
 },
 "views": [
  {
   "id": "log",
   "type": "linkedlist",
   "title": {
    "en": "original log: next above, related below",
    "ko": "원본 로그: 위는 next, 아래는 related"
   }
  },
  {
   "id": "copy",
   "type": "linkedlist",
   "title": {
    "en": "copies[node], at its original's position",
    "ko": "copies[node], 원본과 같은 위치"
   },
   "empty": {
    "en": "no copies yet",
    "ko": "아직 사본 없음"
   }
  },
  {
   "id": "result",
   "type": "output",
   "title": {
    "en": "printed copy",
    "ko": "출력한 사본"
   },
   "empty": {
    "en": "not read yet",
    "ko": "아직 읽지 않음"
   }
  }
 ],
